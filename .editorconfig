root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cpp,h,hpp,cc,cxx}]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{py,ps1}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{sln,vcxproj,props,vsconfig,json,md}]
end_of_line = crlf
indent_style = space
indent_size = 2
